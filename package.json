{
	"name": "dashboard_help_badge",
	"version": "0.5.0",
	"description": "Accessible, configurable contextual help for Dashboard Studio tiles",
	"author": "Leiter Consulting",
	"license": "MIT",
	"private": true,
	"homepage": "https://github.com/LeiterConsulting/dashboard-help-badge#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LeiterConsulting/dashboard-help-badge.git"
	},
	"bugs": {
		"url": "https://github.com/LeiterConsulting/dashboard-help-badge/issues"
	},
	"engines": {
		"node": ">=22",
		"npm": ">=10"
	},
	"type": "module",
	"scripts": {
		"build": "node build.mjs --entry=visualization.ts",
		"build:prod": "NODE_ENV=production node build.mjs --entry=visualization.ts",
		"dev": "node build.mjs --entry=visualization.ts --watch",
		"package": "node package.mjs",
		"test": "tsx --test tests/**/*.test.ts",
		"typecheck": "tsc --noEmit",
		"check:release": "node scripts/check-release.mjs",
		"scan:public": "node scripts/scan-public-tree.mjs",
		"verify": "npm run typecheck && npm test && npm run check:release && npm run scan:public && npm run build:prod && npm run package"
	},
	"devDependencies": {
		"@splunk/dashboard-studio-extension": "^1.0.0",
		"@types/node": "^22.20.1",
		"chalk": "^5.3.0",
		"esbuild": "^0.28.2",
		"tar": "^7.4.3",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2"
	}
}
